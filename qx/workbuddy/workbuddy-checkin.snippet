# WorkBuddy App 每日自动签到获取积分 —— Quantumult X 片段配置
# 注意: QX 的「重写引用」只导入 [rewrite_local] 和 [MITM]，[task_local] 不会被
#       自动导入！定时任务必须到 QX「设置-定时任务」里手动添加（见下方任务行）。
#
# 部署步骤:
#   1. 重写引用导入本片段（或手动抄 [rewrite_local] 的一行 + MITM hostname）
#   2. 定时任务面板手动添加一条: 10 9 * * * <wb_checkin.js的raw链接>, tag=WorkBuddy签到
#   3. 开启 MITM 与重写规则，手机 WorkBuddy App 打开「Buddy 加油站/签到」页面，
#      等通知「token 获取成功✅」，然后单条禁用 get_token 那条重写规则。
# token 一般两个月左右过期，失效时脚本会通知你重新抓一次。

[rewrite_local]
# token 抓取（抓到后可在 QX 重写列表里单独关闭这条）
^https?:\/\/(copilot\.tencent\.com|www\.codebuddy\.cn)\/v2\/ url script-request-header https://raw.githubusercontent.com/weiyongling/weiyongling.github.io/main/qx/workbuddy/wb_get_token.js

[task_local]
; WorkBuddy 每日签到（09:10 执行；接口幂等，重复执行不会重复领积分）
10 9 * * * https://raw.githubusercontent.com/weiyongling/weiyongling.github.io/main/qx/workbuddy/wb_checkin.js, tag=WorkBuddy签到, enabled=true

[task_local]
30 8,20 * * * https://raw.githubusercontent.com/weiyongling/weiyongling.github.io/main/qx/workbuddy/wb_checkin.js, img-url=https://raw.githubusercontent.com/weiyongling/weiyongling.github.io/main/qx/workbuddy/workbuddy.png, tag=PingMe签到, enabled=true

[MITM]
hostname = copilot.tencent.com, www.codebuddy.cn
