# 淘金币每日自动签到+任务 (Quantumult X 重写引用)
# 部署: ①重写引用导入本片段 ②MITM hostname 加 h5api.m.taobao.com
#       ③手机淘宝-我的-淘金币, 等通知 cookie 获取成功
#       ④定时任务手动添加: 20 10 * * * <tb_task.js>, tag=淘金币任务
# cookie 失效约1~2周, 脚本自动续token, 不行会通知重抓

[rewrite_local]
^https?:\/\/h5api\.m\.taobao\.com\/h5\/mtop\. url script-request-header https://raw.githubusercontent.com/weiyongling/weiyongling.github.io/main/qx/taojinbi/tb_cookie.js

[task_local]
20 10 * * * https://raw.githubusercontent.com/weiyongling/weiyongling.github.io/main/qx/taojinbi/tb_task.js, tag=淘金币任务, enabled=true

[MITM]
hostname = h5api.m.taobao.com
